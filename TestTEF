local function createToggle(parent, name, text, isMaster, categoryData)
    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1, -10, 0, 35)
    frame.BackgroundColor3 = Color3.fromRGB(39, 39, 42)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
    
    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(0, 40, 0, 20)
    btn.Position = UDim2.new(1, -50, 0.5, -10)
    
    btn.MouseButton1Click:Connect(function()
        if isMaster then State.Master = not State.Master
        elseif name == "NoclipToggle" then State.Noclip = not State.Noclip
        elseif categoryData then
            local s = not State.Categories[categoryData.Name]
            State.Categories[categoryData.Name] = s
            for _, item in ipairs(categoryData.Items) do State.Items[item] = s end
        else State.Items[name] = not State.Items[name] end
    end)
end

